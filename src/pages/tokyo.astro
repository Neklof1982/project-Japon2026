---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/marco/Hero.astro';
import NavSecciones from '../components/marco/NavSecciones.astro';
import Conexion from '../components/marco/Conexion.astro';
import Footer from '../components/marco/Footer.astro';
import Seccion from '../components/ui/Seccion.astro';
import DiaHead from '../components/ui/DiaHead.astro';
import Mision from '../components/ui/Mision.astro';
import Aviso from '../components/ui/Aviso.astro';
import VueltaHotel from '../components/ui/VueltaHotel.astro';
import Foto from '../components/ui/Foto.astro';
import Galeria from '../components/ui/Galeria.astro';
import Timeline from '../components/ruta/Timeline.astro';
import TL from '../components/ruta/TL.astro';
import Linea from '../components/ruta/Linea.astro';
import Est from '../components/ruta/Est.astro';
import MiniMapa from '../components/ruta/MiniMapa.astro';
import MapaAndando from '../components/ruta/MapaAndando.astro';
import TarjetaEstacion from '../components/ruta/TarjetaEstacion.astro';
import Pasos from '../components/ruta/Pasos.astro';
import TablaTransporte from '../components/ruta/TablaTransporte.astro';
import TarjetaTaxi from '../components/ayuda/TarjetaTaxi.astro';
import FrasesAyuda from '../components/ayuda/FrasesAyuda.astro';
import BloqueCeliaco from '../components/ayuda/BloqueCeliaco.astro';
import { HOTELES } from '../data/viaje';
import { LINEAS, type LineaId } from '../data/lineas';
import { lin, est, dir } from '../lib/html';

const Ht = HOTELES.tokyo;
const Hh = (n: number, nom?: string) => est('hibiya', n, nom);
const G = (n: number, nom?: string) => est('ginza', n, nom);
const Mm = (n: number, nom?: string) => est('marunouchi', n, nom);
const JY = (n: number, nom?: string) => est('yamanote', n, nom);

const lineasTokyo: { l: LineaId; foto: string; pista: string; codigos: [number, string][]; uso: string; extra: string }[] = [
  { l: 'hibiya', foto: 'hibiya-line', pista: 'La H dentro del círculo gris plata.', codigos: [[5, 'Kamiyacho'], [9, 'Ginza'], [11, 'Tsukiji'], [12, 'Hatchobori'], [16, 'Akihabara'], [18, 'Ueno']], uso: 'Nuestra línea “de casa”: Hatchobori → Tsukiji, Ginza, Kamiyacho y Akihabara.', extra: '<strong>H12 Hatchobori</strong> es nuestra referencia principal. Direcciones: <strong>Naka-meguro</strong> (hacia Ginza/Kamiyacho) y <strong>Kita-senju</strong> (hacia Akihabara/Ueno).' },
  { l: 'ginza', foto: 'ginza-line', pista: 'El círculo naranja con G.', codigos: [[1, 'Shibuya'], [2, 'Omote-sando'], [9, 'Ginza'], [16, 'Ueno'], [19, 'Asakusa']], uso: 'Shibuya ↔ Omotesando ↔ Ginza ↔ Ueno ↔ Asakusa.', extra: 'El 31/10: <strong>G19 Asakusa → G16 Ueno</strong> (3 paradas), dirección <strong>Shibuya</strong>.' },
  { l: 'yamanote', foto: 'yamanote', pista: 'Banda verde claro y código JY.', codigos: [[1, 'Tokyo'], [3, 'Akihabara'], [5, 'Ueno'], [17, 'Shinjuku'], [19, 'Harajuku'], [20, 'Shibuya']], uso: 'Gran conector circular. Útil Ueno → Akihabara y Shinjuku → Harajuku/Shibuya.', extra: 'Direcciones: <strong>Inner Loop / 内回り</strong> y <strong>Outer Loop / 外回り</strong>. Si dudamos, manda el destino de la pantalla.' },
  { l: 'marunouchi', foto: 'marunouchi-line', pista: 'Círculo rojo con M. La veremos para Shinjuku.', codigos: [[8, 'Shinjuku'], [16, 'Ginza'], [17, 'Tokyo']], uso: 'Alternativa clara para Ginza → Shinjuku sin depender de JR.', extra: 'El 1/11: <strong>M16 Ginza → M08 Shinjuku</strong> (8 paradas), dirección <strong>Ogikubo</strong>.' },
  { l: 'asakusa', foto: 'asakusa-line', pista: 'La A en círculo rosa. No confundir con la G naranja.', codigos: [[11, 'Higashi-ginza']], uso: 'Plan B ferroviario hacia Haneda (conecta con Keikyu).', extra: 'La <strong>pantalla</strong> decide si el tren continúa hasta Haneda. No subimos solo por ver una A.' },
  { l: 'yurakucho', foto: 'shintomicho', pista: 'Y dorada. Alternativa desde Shintomicho.', codigos: [[20, 'Shintomicho']], uso: 'Alternativa para salir desde el hotel: salida 5, a unos 2 min.', extra: 'No es nuestra línea principal: <strong>H12 Hatchobori</strong> sigue siendo la referencia.' },
];
---
<BaseLayout title="Japón 2026 · Fase 4 — Tokyo" description="Tokyo del 28 de octubre al 2 de noviembre: Ginza, Tsukiji, Meiji, Shibuya, Odaiba, Asakusa, Akihabara, Shinjuku y Haneda." fase="tokyo">
  <Hero
    tag="Japón · Octubre–Noviembre 2026 · Fase 4"
    titulo="Tokyo · <strong>guía para movernos sin perdernos</strong>"
    parrafos={['28 OCT – 1 NOV · 4 personas · base: <strong>APA Hotel Hatchobori Shintomicho</strong>. La prioridad no es ver “todo Tokyo”: es movernos por zonas, entender las líneas y llegar a cada sitio sin dudas.']}
    meta={[
      { v: '28 OCT', l: 'Centro · Ginza · teamLab' },
      { v: '29 OCT', l: 'Tsukiji · Hamarikyu · Ginza' },
      { v: '30 OCT', l: 'Meiji · Shibuya · Odaiba' },
      { v: '31 OCT', l: 'Asakusa · Ueno · Akihabara' },
      { v: '1 NOV', l: 'Shinjuku · Haneda' },
    ]}
  />
  <NavSecciones items={[
    { href: '#mapa', label: 'Mapa mental' },
    { href: '#d28', label: '28 · Llegada', clave: true },
    { href: '#hotel', label: 'Hotel' },
    { href: '#lineas', label: 'Líneas' },
    { href: '#d29', label: '29 OCT' },
    { href: '#d30', label: '30 OCT' },
    { href: '#d31', label: '31 OCT' },
    { href: '#d1', label: '1 NOV · Haneda', clave: true },
    { href: '#taxi', label: 'Taxi' },
    { href: '#decision', label: 'Decisión' },
    { href: '#transporte', label: 'Transporte' },
  ]} />

  <Conexion fase="tokyo" modo="desde" />

  <Seccion id="mapa" kicker="1 · Antes de salir" titulo="El <strong>mapa mental</strong> que vamos a usar" lead="Tokyo no se divide oficialmente en cuatro zonas, pero para nuestro viaje sí nos sirve pensar así. La regla: <strong>no cruzamos la ciudad sin motivo</strong>.">
    <div class="cards">
      <div class="card"><h3>① Centro / Este</h3><p>Tokyo Station · Marunouchi · Ginza · Tsukiji · Hamarikyu · Hatchobori.</p><p><strong>Base del hotel.</strong></p></div>
      <div class="card"><h3>② Noreste tradicional</h3><p>Asakusa · Kappabashi · Ueno · Ameyoko · Akihabara.</p><p><strong>Ginza Line + Hibiya + JR.</strong></p></div>
      <div class="card"><h3>③ Oeste</h3><p>Shinjuku · Meiji Jingu · Harajuku · Omotesando · Shibuya.</p><p><strong>Yamanote / Metro / taxi.</strong></p></div>
      <div class="card"><h3>④ Sur / bahía</h3><p>Azabudai Hills · Tokyo Tower · Odaiba. Aquí el taxi para 4 nos ahorra tiempo y cambios.</p></div>
    </div>
    <h3 class="sub-h">📸 Primero miramos la foto; después Google Maps</h3>
    <p class="lead">Las señales y lugares que nos interesa reconocer de verdad. Buscamos el nombre y el código antes de bajar al andén o elegir una salida.</p>
    <Galeria cols={4} h="165px">
      <Foto id="tokyo-yaesu" titulo="Tokyo Station · Yaesu South" texto="El 28/10 salimos por aquí con las maletas: 八重洲南口." />
      <Foto id="hatchobori" titulo={`Hatchobori · ${Hh(12)}`} texto="Nuestra estación de casa. Salida A3 para el hotel." />
      <Foto id="kamiyacho" titulo={`Kamiyacho · ${Hh(5)}`} texto="Para teamLab Borderless. Exit 5 hacia Azabudai Hills." />
      <Foto id="kaminarimon" titulo="Asakusa · Kaminarimon" texto={`El 31/10 empezamos aquí. Metro: ${G(19)}.`} />
      <Foto id="tokyo-marunouchi" titulo="Marunouchi" texto="La fachada roja de Tokyo Station: punto visual del 28/10." />
      <Foto id="tsukiji" titulo="Tsukiji Outer Market" texto="El 29/10 entramos por el mercado y caminamos a Hamarikyu." />
      <Foto id="meiji-torii" titulo="Meiji Jingu" texto="El 30/10 por la entrada de Harajuku. Hasta el santuario, ~10 min más." />
      <Foto id="shibuya-cruce" titulo="Shibuya" texto="El cruce y Shibuya Sky (reserva con hora)." />
      <Foto id="odaiba" titulo="Odaiba" texto="Estatua de la Libertad + Rainbow Bridge. No incluimos el Gundam." />
      <Foto id="akihabara" titulo="Akihabara" texto={`Último tramo del 31/10. Desde Ueno, ${JY(5)} → ${JY(3)}.`} />
      <Foto id="godzilla" titulo="Shinjuku · Godzilla" texto="El 1/11 hacia las 17:00, con ambiente de tarde-noche." />
      <Foto id="tmg" titulo="Tokyo Metropolitan Government" texto="Mirador gratuito en Shinjuku si hay visibilidad." />
    </Galeria>
    <Aviso titulo="Tokyo parece complicado, pero no necesitamos memorizar el mapa.">
      <p>En cada estación buscamos siempre cuatro cosas: <strong>COLOR → LÍNEA → DESTINO/DIRECCIÓN → PANTALLA</strong>. Si una no coincide, no subimos todavía.</p>
    </Aviso>
  </Seccion>

  <Seccion id="d28" fondo="alt">
    <DiaHead fecha="MIÉRCOLES · 28 OCT · desde la Fase 3" titulo="Tokyo Station → hotel → Marunouchi → Ginza → <strong>teamLab Borderless</strong>" zona="Centro" />
    <p class="lead">Día de llegada desde Kyoto. No lo cargamos: primero dejamos las maletas en el hotel y después un recorrido compacto.</p>
    <Mision kicker="KYOTO → TOKYO" main="Shinkansen → Tokyo Station → taxi al hotel" ruta={['京都', '東京', 'Yaesu', 'Hotel']} small="Bajamos en los andenes 14–19 del Shinkansen. Seguimos 八重洲 / Yaesu y la señal de taxi. Exactamente al revés que el día 21." />
    <TarjetaEstacion kicker="Llegada · el tramo que une Kyoto con Tokyo" titulo="Andén del Shinkansen → Yaesu South → taxi" texto="Ya conocemos esta estación: es la misma ruta del día 21, en sentido contrario.">
      <MiniMapa
        titulo="Tokyo Station → APA Hotel Hatchobori Shintomicho"
        paradas={[
          { nombre: 'Andenes 14–19', sub: 'Shinkansen', tipo: 'destacado', sig: { modo: 'andar', label: '🚶 bajar a 1F' } },
          { nombre: 'Puertas', sub: 'Shinkansen', sig: { modo: 'andar', label: '🚶' } },
          { nombre: 'Yaesu South', sub: '八重洲南口 · taxis', tipo: 'destacado', sig: { modo: 'taxi', label: '🚕 10–12 min' } },
          { nombre: 'Hotel', sub: 'Shintomi 1-17-8', tipo: 'hotel' },
        ]}
      />
      <Pasos items={[
        { t: 'Al bajar del tren, buscamos 出口 / Exit y 八重洲 / Yaesu.', d: 'Escaleras mecánicas o ascensor hasta la planta de las puertas.' },
        { t: 'Salimos por las puertas del Shinkansen hacia Yaesu South.', d: 'Metemos el billete/QR igual que a la entrada.' },
        { t: 'Fuera: parada de taxis (タクシー乗り場).', d: 'Enseñamos la tarjeta del hotel. Con 4 personas y maletas, taxi grande si hay.' },
      ]} />
    </TarjetaEstacion>
    <div class="taxi-grid">
      <TarjetaTaxi etiqueta="Tokyo Station → hotel" jp={Ht.jp} romaji={Ht.nombre} frase="このホテルまでお願いします。" fraseEs="A este hotel, por favor." dire={Ht.direccionJp} />
      <Foto id="tokyo-marunouchi" titulo="Después: Marunouchi" texto="La fachada histórica de Tokyo Station, al otro lado de la estación." h="220px" />
    </div>
    <Timeline>
      <TL hora="Llegada" titulo="Tokyo Station → hotel" tipo="taxi" etiqueta="Taxi">Dejamos maletas (o hacemos el check-in si ya es la hora).</TL>
      <TL hora="Tarde" titulo="Marunouchi + Ginza" tipo="andar">Volvemos a Tokyo Station (taxi corto o andando ~17 min), miramos la fachada de Marunouchi y caminamos hacia Ginza. Si queremos ahorrar piernas: <Est l="marunouchi" n={17} /> Tokyo → <Est l="marunouchi" n={16} nombre="Ginza" />, 1 parada.</TL>
      <TL hora="17:30–18:00" titulo="teamLab Borderless" prio="must" prioTexto="MUST" tipo="metro">
        <Fragment slot="lineas"><Linea l="hibiya" dir="Naka-meguro" /></Fragment>
        Desde Ginza <Est l="hibiya" n={9} /> → <Est l="hibiya" n={5} nombre="Kamiyacho" />, 4 paradas. En H05 buscamos <strong>Exit 5</strong> hacia Azabudai Hills.
      </TL>
      <TL hora="Noche" titulo="Cena + vuelta" tipo="taxi">Cena por Azabudai/Roppongi o taxi directo al hotel. No complicamos el regreso.</TL>
    </Timeline>
    <MapaAndando
      titulo="Marunouchi → Ginza a pie"
      sub="De la fachada de Tokyo Station a Ginza por Marunouchi Naka-dori y Yurakucho."
      ciudad="Tokyo"
      distancia="≈ 1,8 km"
      tiempo="~25 min + paradas"
      puntos={[
        { n: 'Tokyo Station · Marunouchi', lat: 35.6812, lon: 139.7649, q: 'Tokyo Station Marunouchi Building' },
        { n: 'Marunouchi Naka-dori', lat: 35.6780, lon: 139.7635, q: 'Marunouchi Naka-dori, Tokyo' },
        { n: 'Yurakucho', lat: 35.6751, lon: 139.7630, q: 'Yurakucho Station, Tokyo' },
        { n: 'Ginza 4-chome · Wako', lat: 35.6717, lon: 139.7650, t: 'fin', q: 'Ginza Wako, Tokyo' },
      ]}
      zonas={[{ n: 'Marunouchi', lat: 35.6800, lon: 139.7610 }, { n: 'Ginza', lat: 35.6705, lon: 139.7680 }]}
    />
    <MiniMapa
      titulo={`Ginza ${Hh(9)} → Kamiyacho ${Hh(5)} · teamLab`}
      nota={`${lin('hibiya')} ${dir('Naka-meguro')} · 4 paradas`}
      paradas={[
        { nombre: 'Ginza', est: ['hibiya', 9], tipo: 'destacado', sig: { modo: 'linea', l: 'hibiya' } },
        { nombre: 'Hibiya', est: ['hibiya', 8], sig: { modo: 'linea', l: 'hibiya' } },
        { nombre: 'Kasumigaseki', est: ['hibiya', 7], sig: { modo: 'linea', l: 'hibiya' } },
        { nombre: 'Toranomon Hills', est: ['hibiya', 6], sig: { modo: 'linea', l: 'hibiya' } },
        { nombre: 'Kamiyacho', sub: 'Exit 5', est: ['hibiya', 5], tipo: 'destacado', sig: { modo: 'andar', label: '🚶 conectado' } },
        { nombre: 'teamLab', sub: 'Azabudai Hills', tipo: 'destacado' },
      ]}
      check="<strong>Importante:</strong> la hora exacta de entrada a teamLab depende de la reserva. No la dejamos para el último momento."
    />
    <Galeria cols={3} h="190px">
      <Foto id="ginza" titulo="Ginza · Wako" texto="El reloj de Wako en el cruce de Ginza 4-chome." />
      <Foto id="kamiyacho" titulo="Kamiyacho H05" texto="Estación gris plata de la Hibiya Line." />
      <Foto id="azabudai" titulo="Azabudai Hills" texto="Aquí dentro está teamLab Borderless." />
    </Galeria>
  </Seccion>

  <Seccion id="hotel" kicker="2 · Referencia" titulo="Nuestro hotel: <strong>el punto de referencia</strong>" lead="1-17-8 Shintomi, Chuo-ku. Dos accesos útiles: <strong>Shintomicho Y20 · salida 5</strong> (unos 2 min) y <strong>Hatchobori H12 · salida A3</strong> (unos 5 min). Para nuestras rutas usaremos sobre todo la Hibiya Line en Hatchobori.">
    <TarjetaEstacion
      kicker="Señal que reconocemos"
      titulo={`${Hh(12)} · Hatchobori 八丁堀`}
      texto="Tokyo Metro Hibiya Line (gris plata). Salida A3 → hotel, unos 5 min."
      cartel={{ nombre: 'Hatchobori', jp: '八丁堀', operador: 'Tokyo Metro · Hibiya Line', codigos: [['hibiya', 12]] }}
      foto="shintomicho"
      fotoTitulo="Shintomicho · salida 5"
      fotoTexto="La salida más cercana al hotel (Yurakucho Line Y20)."
    >
      <Pasos items={[
        { t: 'Desde el hotel, Hatchobori salida A3.', d: `Para casi todo: ${lin('hibiya')}.` },
        { t: 'Hacia Ginza, Tsukiji, Kamiyacho:', d: `${dir('Naka-meguro')}.` },
        { t: 'Hacia Akihabara, Ueno:', d: `${dir('Kita-senju')}.` },
      ]} />
    </TarjetaEstacion>
    <MapaAndando
      titulo="Hotel ↔ estaciones de metro"
      sub="Shintomicho (2 min) y Hatchobori (5 min)."
      ciudad="Tokyo"
      distancia="≈ 200–450 m"
      tiempo="2–5 min"
      puntos={[
        { n: 'Shintomicho Y20 · salida 5', lat: 35.6707, lon: 139.7737, t: 'estacion', q: 'Shintomicho Station Exit 5, Tokyo' },
        { n: 'APA Hatchobori Shintomicho', lat: 35.6718, lon: 139.7745, t: 'paso', q: 'APA Hotel Hatchobori Shintomicho' },
        { n: 'Hatchobori H12 · salida A3', lat: 35.6745, lon: 139.7772, t: 'estacion', q: 'Hatchobori Station Exit A3, Tokyo' },
      ]}
    />
    <Aviso titulo="Importante"><p>Hay varios APA en la zona de Hatchobori. En taxi o en Google Maps enseñamos siempre el nombre completo <strong>APA Hotel Hatchobori Shintomicho / <span class="jp">アパホテル〈八丁堀 新富町〉</span></strong>.</p></Aviso>
  </Seccion>

  <Seccion id="regla" fondo="crema" kicker="3 · La regla" titulo="La regla de los <strong>4 datos</strong>">
    <div class="cards">
      <div class="card"><h3>① COLOR</h3><p>Ej.: Hibiya = <Linea l="hibiya" corta /> gris plata. Ginza = <Linea l="ginza" corta /> naranja.</p></div>
      <div class="card"><h3>② LÍNEA</h3><p>Ej.: Hibiya Line <strong>H</strong>. Ginza Line <strong>G</strong>.</p></div>
      <div class="card"><h3>③ DESTINO</h3><p>No buscamos el número de nuestra estación: miramos el <strong>destino final</strong> del tren.</p></div>
      <div class="card"><h3>④ PANTALLA</h3><p>La pantalla manda: <strong>hora + destino + andén</strong>. Ejemplo: de Hatchobori a Tsukiji buscamos <Est l="hibiya" n={11} /> y el tren hacia <strong>Naka-meguro</strong>.</p></div>
    </div>
    <Galeria cols={2}>
      <Foto id="metro-sign" titulo="Así es un cartel de andén de Tokyo Metro" texto="Arriba: el código de la estación dentro del círculo del color de la línea, el nombre en japonés e inglés y, a los lados, la estación anterior y la siguiente con flechas. Debajo, el plano de la línea con los minutos a cada parada." />
      <Foto id="hatchobori" titulo="Boca de metro de Hatchobori" texto="El símbolo azul de Tokyo Metro y el nombre 八丁堀. Nuestra estación de casa." />
    </Galeria>
  </Seccion>

  <Seccion id="lineas" kicker="4 · Las líneas" titulo="Nuestras líneas de <strong>Tokyo</strong>" lead="No hace falta aprender toda la red. Estas 6 líneas son las que realmente usamos. El color es la primera pista visual.">
    <div class="cards">
      {lineasTokyo.map((x) => (
        <div class="card" style={`border-top:6px solid ${LINEAS[x.l].color}`}>
          <div style="margin:-26px -26px 16px;overflow:hidden;border-radius:10px 10px 0 0"><Foto id={x.foto} h="140px" /></div>
          <Linea l={x.l} />
          <p style="margin-top:8px;font-size:12px"><em>{x.pista}</em> · color <strong>{LINEAS[x.l].colorEs}</strong></p>
          <p style="display:flex;flex-wrap:wrap;gap:6px">{x.codigos.map(([n, nom]) => <span><Est l={x.l} n={n} /> <small>{nom}</small></span>)}</p>
          <p><strong>Uso:</strong> {x.uso}</p>
          <p set:html={x.extra} />
        </div>
      ))}
    </div>
    <Aviso titulo="Regla visual en el andén"><p>Primero el <strong>COLOR</strong>, después la <strong>LETRA</strong>, luego el <strong>DESTINO</strong> y por último la <strong>PANTALLA</strong>. Ejemplo: <Linea l="hibiya" corta /> gris → <Est l="hibiya" n={12} nombre="Hatchobori" /> → dirección <strong>Naka-meguro</strong>.</p></Aviso>
  </Seccion>

  <Seccion id="d29" fondo="alt">
    <DiaHead fecha="JUEVES · 29 OCT" titulo="Tsukiji → Hamarikyu → Ginza → <strong>Yurakucho / Tokyo</strong>" zona="Centro / Este" />
    <MiniMapa
      titulo={`Desde el hotel, la ruta fácil: ${Hh(12)} → ${Hh(11)}`}
      nota="El día más sencillo: una sola parada de Hibiya para empezar y todo lo demás a pie."
      paradas={[
        { nombre: 'Hatchobori', est: ['hibiya', 12], tipo: 'hotel', sig: { modo: 'linea', l: 'hibiya', label: '1 parada' } },
        { nombre: 'Tsukiji', est: ['hibiya', 11], tipo: 'destacado', sig: { modo: 'andar', label: '🚶' } },
        { nombre: 'Hamarikyu', sub: 'a pie', sig: { modo: 'andar', label: '🚶' } },
        { nombre: 'Ginza', sub: 'paseo', tipo: 'destacado' },
      ]}
      giros={[
        `Hotel → ${Hh(12, 'Hatchobori')}.`,
        `${lin('hibiya', true)} ${dir('Naka-meguro')} → ${Hh(11, 'Tsukiji')}.`,
        'Después del jardín, a <strong>Ginza</strong> caminando o en taxi corto.',
      ]}
    />
    <Timeline>
      <TL hora="08:30" titulo={`Hatchobori ${Hh(12)} → Tsukiji ${Hh(11)}`} tipo="metro"><Fragment slot="lineas"><Linea l="hibiya" dir="Naka-meguro" /></Fragment>Solo 1 parada.</TL>
      <TL hora="09:00" titulo="Tsukiji Outer Market" prio="must" prioTexto="MUST">Salida que indique la señalización hacia Outer Market / Tsukiji Hongwanji.</TL>
      <TL hora="10:30" titulo="Tsukiji Hongwanji → Hamarikyu" tipo="andar">Tramo a pie. No volvemos al metro.</TL>
      <TL hora="11:00–13:00" titulo="Hamarikyu" prio="must" prioTexto="MUST">Entrada general 9:00–17:00; última entrada 16:30. Dejamos margen.</TL>
      <TL hora="13:00+" titulo="Hamarikyu → Ginza" tipo="andar">Si estamos bien, caminamos. Si llueve o hay cansancio, taxi corto.</TL>
      <TL hora="Tarde" titulo="Ginza → Yurakucho → Tokyo" tipo="andar">Paseo libre.</TL>
    </Timeline>
    <MapaAndando
      titulo="Tsukiji → Hamarikyu → Ginza"
      sub="Mercado, templo, jardín y Ginza: todo andando."
      ciudad="Tokyo"
      distancia="≈ 3 km"
      tiempo="~40 min andando + visitas"
      puntos={[
        { n: 'Tsukiji H11', lat: 35.6680, lon: 139.7718, t: 'estacion', q: 'Tsukiji Station, Tokyo' },
