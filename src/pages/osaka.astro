---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/marco/Hero.astro';
import NavSecciones from '../components/marco/NavSecciones.astro';
import Conexion from '../components/marco/Conexion.astro';
import Footer from '../components/marco/Footer.astro';
import Seccion from '../components/ui/Seccion.astro';
import DiaHead from '../components/ui/DiaHead.astro';
import Mision from '../components/ui/Mision.astro';
import Aviso from '../components/ui/Aviso.astro';
import Prio from '../components/ui/Prio.astro';
import VueltaHotel from '../components/ui/VueltaHotel.astro';
import Foto from '../components/ui/Foto.astro';
import Galeria from '../components/ui/Galeria.astro';
import Timeline from '../components/ruta/Timeline.astro';
import TL from '../components/ruta/TL.astro';
import Linea from '../components/ruta/Linea.astro';
import Est from '../components/ruta/Est.astro';
import MiniMapa from '../components/ruta/MiniMapa.astro';
import MapaAndando from '../components/ruta/MapaAndando.astro';
import TarjetaEstacion from '../components/ruta/TarjetaEstacion.astro';
import Pasos from '../components/ruta/Pasos.astro';
import TablaTransporte from '../components/ruta/TablaTransporte.astro';
import TarjetaTaxi from '../components/ayuda/TarjetaTaxi.astro';
import FrasesAyuda from '../components/ayuda/FrasesAyuda.astro';
import BloqueCeliaco from '../components/ayuda/BloqueCeliaco.astro';
import { HOTELES } from '../data/viaje';
import { lin, est, dir } from '../lib/html';

const H = HOTELES.osaka;
const M = (n: number, nom?: string) => est('midosuji', n, nom);
const C = (n: number, nom?: string) => est('chuo', n, nom);
const T = (n: number, nom?: string) => est('tanimachi', n, nom);
const A = (n: number, nom?: string) => est('kintetsu', n, nom);
const midoS = `${lin('midosuji')} ${dir('Nakamozu')}`;
const midoN = `${lin('midosuji')} ${dir('Minoh-kayano')}`;
---
<BaseLayout title="Japón 2026 · Fase 2 — Osaka + Nara" description="Osaka desde Hommachi: llegada, cuatro planes intercambiables (Castillo, Tennoji, Minami, Nara) y salida a Kyoto." fase="osaka">
  <Hero
    tag="Japón · Octubre 2026 · Fase 2"
    titulo="<strong>Osaka</strong> + Nara<br>guía para movernos sin perdernos"
    parrafos={['La usamos como chuleta durante el viaje. No necesitamos memorizar estaciones: en cada desplazamiento tenemos la estación, la línea con su color, la dirección, las paradas que contamos, la salida y lo que hacemos al salir.']}
    meta={[
      { v: '21–25 OCT', l: '4 noches en Osaka' },
      { v: '4 PERSONAS', l: '1 viajero celíaco' },
      { v: 'HOTEL', l: 'Far East Village Osaka Honmachi' },
      { v: '22–24', l: '4 planes intercambiables' },
    ]}
  />
  <NavSecciones items={[
    { href: '#mapa', label: 'Mapa' },
    { href: '#llegada', label: '21 · Llegada', clave: true },
    { href: '#hotel', label: 'Hotel' },
    { href: '#dia21', label: '21 · Tarde' },
    { href: '#planes', label: '22–24 · Planes' },
    { href: '#a', label: 'A · Castillo' },
    { href: '#b', label: 'B · Tennoji' },
    { href: '#c', label: 'C · Minami' },
    { href: '#d', label: 'D · Nara' },
    { href: '#dia25', label: '25 · Kyoto', clave: true },
    { href: '#transporte', label: 'Transporte' },
  ]} />

  <Conexion fase="osaka" modo="desde" />

  <Seccion id="mapa" kicker="Antes de salir" titulo="La idea es muy <strong>sencilla</strong>" lead="La base está en Hommachi. Cada día salimos del hotel hacia una zona concreta, la recorremos principalmente a pie y volvemos a Hommachi por la tarde-noche para cenar cerca y descansar. Los días 22, 23 y 24 son intercambiables: elegimos entre los planes según el tiempo y el cansancio. El 25 no hacemos excursión larga: maletas, como mucho un plan cercano y salida hacia Kyoto.">
    <Mision kicker="PUNTO FIJO" main="Far East Village Hotel Osaka Honmachi" ruta={['本町', 'Hommachi']} small={`Osaka Metro: ${M(18)} ${C(16)} ${est('yotsubashi', 13)} · hotel a unos 4–5 min andando.`} />
    <div class="route-strip">
      <div class="route-step active"><span>H</span><strong>Hommachi</strong><small>M18 · C16 · Y13</small></div><div class="route-line"></div>
      <div class="route-step"><span>A</span><strong>Castillo</strong><small>C18 · T23</small></div><div class="route-line"></div>
      <div class="route-step"><span>B</span><strong>Tennoji</strong><small>T26 · M23 · M26</small></div><div class="route-line"></div>
      <div class="route-step"><span>C</span><strong>Minami</strong><small>M19 · M20</small></div><div class="route-line"></div>
      <div class="route-step nara"><span>D</span><strong>Nara</strong><small>A01 → A28</small></div>
    </div>
    <div class="cards">
      <div class="card"><h3>🚇 Contamos paradas</h3><div class="stat">1 · 2 · 3…</div><p>Al subir miramos nuestro destino y contamos estaciones. Ejemplo: <Est l="midosuji" n={18} /> → <Est l="midosuji" n={20} /> = 2 paradas. Si nos pasamos, bajamos en la siguiente y corregimos.</p></div>
      <div class="card"><h3>🚶 Caminamos cuando compensa</h3><div class="stat">5–20 MIN</div><p>Si ya estamos en una zona interesante, mejor caminar que volver a bajar al metro. El día se disfruta más así.</p></div>
      <div class="card"><h3>🌙 Volvemos a Hommachi</h3><div class="stat">19:00–20:30</div><p>Cada plan tiene su propia vuelta. La idea base es cenar cerca del hotel y dormir sin improvisar.</p></div>
    </div>
    <h3 class="sub-h">📸 Primero miramos la foto; después Google Maps</h3>
    <p class="lead">No dependemos solo del punto azul. Miramos la foto de la estación, buscamos el código y comprobamos el número de salida. Si la señal real coincide, seguimos.</p>
    <Galeria cols={4} h="170px">
      <Foto id="shin-osaka" titulo={`Shin-Osaka · ${M(13)}`} texto="Aquí llegamos en Shinkansen y desde aquí salimos hacia Kyoto." />
      <Foto id="hommachi" titulo={`Hommachi · ${M(18)}`} texto="Nuestra estación. Para el hotel, Exit 12; con maletas, Exit 7." />
      <Foto id="kintetsu-namba" titulo={`Osaka-Namba · ${A(1)}`} texto="El cambio importante para Nara: buscamos <strong>Kintetsu</strong>, no JR." />
      <Foto id="kintetsu-nara" titulo={`Kintetsu-Nara · ${A(28)}`} texto="Cuando veamos A28 hemos llegado. De aquí sale el circuito a pie." />
    </Galeria>
    <MiniMapa
      titulo="Salida diaria: no todas las excursiones salen por el mismo lado"
      paradas={[
        { nombre: 'Hommachi', est: ['chuo', 16], tipo: 'hotel', sig: { modo: 'linea', l: 'chuo', label: 'Chuo · 2' } },
        { nombre: 'Tanimachi 4', sub: 'Castillo · Exit 9', est: ['chuo', 18], tipo: 'destacado', sig: { modo: 'linea', l: 'tanimachi', label: 'Tanimachi · 3' } },
        { nombre: 'Shitennoji-mae', sub: 'Exit 4', est: ['tanimachi', 26], tipo: 'destacado' },
      ]}
      giros={[
        `<strong>Castillo</strong> · ${C(16)} → ${C(18)} · 2 paradas · Exit 9.`,
        `<strong>Tennoji</strong> · ${C(16)} → ${C(18)} → ${T(23)} → ${T(26)} · 3 paradas en Tanimachi · Exit 4.`,
        `<strong>Minami</strong> · ${M(18)} → ${M(19)} Shinsaibashi / ${M(20)} Namba · ${dir('Nakamozu')}.`,
        `<strong>Nara</strong> · ${M(18)} → ${M(20)} → ${A(1)} Osaka-Namba → ${A(28)} Kintetsu-Nara.`,
      ]}
      check="<strong>👀 Comprobación rápida:</strong> antes de subir miramos <strong>línea + dirección + destino</strong>. No basta con que el tren tenga el mismo color."
    />
  </Seccion>

  <Seccion id="llegada" fondo="alt" kicker="21 OCT · ~14:20 · desde la Fase 1" titulo="Shin-Osaka → <strong>Hommachi → hotel</strong>" lead="Al bajar del Shinkansen <strong>no buscamos el hotel todavía</strong>. Primero <strong>Osaka Metro → Midosuji Line (rojo) → M13</strong>. No seguimos JR.">
    <MiniMapa
      titulo={`Mini mapa 1 · llegada: ${M(13)} → ${M(18)}`}
      nota={`${midoS} · <strong>5 paradas</strong> · ~10 min. Ojo: <strong>Nakamozu</strong> (hacia el sur), no Minoh-kayano.`}
      paradas={[
        { nombre: 'Shin-Osaka', est: ['midosuji', 13], tipo: 'destacado', sig: { modo: 'linea', l: 'midosuji' } },
        { nombre: 'Nishinakajima', est: ['midosuji', 14], sig: { modo: 'linea', l: 'midosuji' } },
        { nombre: 'Nakatsu', est: ['midosuji', 15], sig: { modo: 'linea', l: 'midosuji' } },
        { nombre: 'Umeda', est: ['midosuji', 16], sig: { modo: 'linea', l: 'midosuji' } },
        { nombre: 'Yodoyabashi', est: ['midosuji', 17], sig: { modo: 'linea', l: 'midosuji' } },
        { nombre: 'Hommachi', est: ['midosuji', 18], tipo: 'destacado', sig: { modo: 'andar', label: '🚶 4–5 min' } },
        { nombre: 'Hotel', sub: 'Exit 12', tipo: 'hotel' },
      ]}
      giros={[
        `En Shin-Osaka buscamos <strong>Osaka Metro / Midosuji Line</strong> ${lin('midosuji', true)}. No seguimos JR.`,
        `Subimos en ${M(13)} ${dir('Nakamozu / Tennoji')}.`,
        `Contamos <strong>5 paradas</strong>: ${M(14)} → ${M(15)} → ${M(16)} → ${M(17)} → ${M(18, 'Hommachi')}.`,
      ]}
      check={`<strong>🎯 Nuestro objetivo es ${M(18)}.</strong> Cuando aparezca <strong>Hommachi / 本町 / M18</strong>, bajamos. Después buscamos <strong>Exit 12</strong>; con maletas, valorar <strong>Exit 7</strong> (ascensor/escalera mecánica).`}
    />
    <Galeria cols={3} h="190px">
      <Foto id="shin-osaka-metro" titulo="El cartel a buscar en Shin-Osaka" texto="Cartel de la estación de Midosuji Line: fondo blanco, franja roja y código M13." />
      <Foto id="midosuji" titulo="El tren de Midosuji" texto="Franja roja. Si el tren es rojo y pone M, vamos bien; falta comprobar la dirección." />
      <Foto id="hommachi" titulo="Puertas de Hommachi" texto="Al salir de las puertas, buscamos el cartel amarillo de salidas: Exit 12." />
    </Galeria>
  </Seccion>

  <Seccion id="hotel" kicker="Hotel" titulo="Hommachi: nuestro <strong>punto fijo</strong>" lead="El hotel está en 3-3-6 Kyutaromachi. La guía del hotel indica Hommachi a unos 4 min: Exit 12 para llegar andando y Exit 7 como alternativa cómoda con equipaje.">
    <TarjetaEstacion
      kicker="Señal que reconocemos"
      titulo="本町 · Hommachi"
      texto="En esta estación confluyen Midosuji (rojo), Chuo (verde) y Yotsubashi (azul)."
      cartel={{ nombre: 'Hommachi', jp: '本町', operador: 'Osaka Metro', codigos: [['midosuji', 18], ['chuo', 16], ['yotsubashi', 13]] }}
    >
      <Pasos items={[
        { t: 'Para el hotel buscamos Exit 12.', d: 'Salimos hacia Shinsaibashi-suji, caminamos hacia el sur, giramos en la primera esquina a Minami-Kyutaromachi-dori y enseguida veremos el hotel.' },
        { t: 'Con maletas podemos usar Exit 7.', d: 'El hotel señala esta salida como alternativa por sus opciones de ascensor/escalera mecánica.' },
        { t: 'Si dudamos, paramos.', d: 'Enseñamos la tarjeta del hotel (abajo) o usamos el botón 🆘 Ayuda.' },
      ]} />
    </TarjetaEstacion>
    <MapaAndando
      titulo="Hommachi Exit 12 → hotel"
      sub="Unos 300 metros. Sur por Shinsaibashi-suji y primera esquina."
      ciudad="Osaka"
      distancia="≈ 300 m"
      tiempo="4–5 min"
      puntos={[
        { n: 'Hommachi · Exit 12', lat: 34.6822, lon: 135.5012, t: 'estacion', q: 'Hommachi Station Exit 12, Osaka' },
        { n: 'Shinsaibashi-suji', lat: 34.6818, lon: 135.5021, q: 'Shinsaibashisuji, Kyutaromachi, Osaka' },
        { n: 'Far East Village Hotel', lat: 34.6806, lon: 135.5024, t: 'fin', q: 'Far East Village Hotel Osaka Honmachi' },
      ]}
    />
    <div class="taxi-grid">
      <TarjetaTaxi etiqueta="Llévenos al hotel" jp={H.jp} romaji={H.nombre} frase="このホテルまでお願いします。" fraseEs="A este hotel, por favor." dire={H.direccionJp} />
    </div>
  </Seccion>

  <Seccion id="dia21" fondo="alt">
    <DiaHead fecha="MIÉRCOLES · 21 OCT" titulo="<strong>Llegada + Hommachi + Minami suave</strong>" zona="Día de llegada" />
    <p class="lead">Hoy no tenemos que demostrar nada. Venimos de Tokyo: llegar, ducharnos, descansar y tener un primer contacto con Osaka. Si estamos cansados, versión corta.</p>
    <div class="choice-grid">
      <div class="choice"><h3><Prio t="must" /> Versión corta</h3><div class="route">HOTEL → SHINSAIBASHI-SUJI → HOTEL</div><p>Salimos del hotel y caminamos por Shinsaibashi-suji. Vemos ambiente, cenamos y volvemos. Si las piernas pesan, ni siquiera necesitamos metro.</p><div class="best">Duración orientativa: 2–3 h · muy fácil de recortar.</div></div>
      <div class="choice"><h3><Prio t="maybe" texto="🟡 SI TENEMOS ENERGÍA" /> Versión ampliada</h3><div class="route">Shinsaibashi → America-Mura → Horie → Dotonbori → Hozenji</div><p>Todo andando, sin volver atrás. Si a mitad de camino estamos cansados, cortamos en Dotonbori y taxi a Hommachi.</p><div class="best">No convertimos esta opción en obligación.</div></div>
    </div>
    <MapaAndando
      titulo="Versión ampliada a pie"
      sub="Del hotel al sur por la galería cubierta, desvío al oeste por America-Mura y Horie, y final en Dotonbori."
      ciudad="Osaka"
      distancia="≈ 3,5 km"
      tiempo="1 h andando + paradas"
      puntos={[
        { n: 'Hotel', lat: 34.6806, lon: 135.5024, t: 'inicio', q: 'Far East Village Hotel Osaka Honmachi' },
        { n: 'Shinsaibashi-suji', lat: 34.6745, lon: 135.5017, q: 'Shinsaibashisuji Shopping Street' },
        { n: 'America-Mura', lat: 34.6721, lon: 135.4983, q: 'Triangle Park, Amerikamura, Osaka' },
        { n: 'Horie', lat: 34.6716, lon: 135.4935, q: 'Orange Street, Horie, Osaka' },
        { n: 'Dotonbori · Ebisubashi', lat: 34.6688, lon: 135.5013, q: 'Ebisubashi Bridge, Osaka' },
        { n: 'Hozenji', lat: 34.6681, lon: 135.5036, t: 'fin', q: 'Hozenji Temple, Osaka' },
      ]}
      zonas={[{ n: 'Minami', lat: 34.6700, lon: 135.5060 }]}
      reco={{ t: '🚕 ¿CANSADOS? TAXI A HOMMACHI', d: 'Desde Dotonbori, 5–10 min al hotel' }}
    />
    <div class="walk-note"><strong>🚶 Por qué aquí caminar y no coger metro</strong>Shinsaibashi está a 1 parada de Hommachi ({M(18)} → {M(19)}), pero desde el hotel el paseo por la galería comercial es más agradable que bajar a la estación. Si usamos metro: <Fragment set:html={midoS} />, 1 parada.</div>
    <VueltaHotel rutas={[{ ruta: `${M(19, 'Shinsaibashi')} → ${M(18, 'Hommachi')}`, texto: `${midoN} · Contamos <strong>1 parada</strong>. Bajamos en M18 y usamos Exit 12. Si estamos cansados, taxi directo al hotel con la tarjeta.` }]} />
    <Aviso tipo="oro" titulo="🍽️ Cena"><p>No damos por segura una cena solo porque “parezca” sin gluten. Preguntamos por trigo, salsa de soja y contaminación cruzada. Si no podemos confirmarlo, opción segura preparada.</p></Aviso>
    <Galeria cols={3} h="190px">
      <Foto id="shinsaibashi" titulo="Shinsaibashi-suji" texto="Galería comercial cubierta: el paseo más fácil desde el hotel." />
      <Foto id="dotonbori" titulo="Dotonbori" texto="El canal y los grandes carteles luminosos. Aquí podemos cortar." />
      <Foto id="hozenji" titulo="Hozenji Yokocho" texto="Callejón empedrado y templo pequeño: el rincón tranquilo de Minami." />
    </Galeria>
  </Seccion>

  <Seccion id="planes" kicker="22–24 OCT · Intercambiable" titulo="Cuatro planes. <strong>Elegimos tres.</strong>" lead="No hay un orden correcto. Cada noche decidimos qué hacer al día siguiente. Los cuatro planes salen de Hommachi, recorren una zona concreta y tienen vuelta independiente al hotel.">
    <div class="choice-grid">
      <a class="choice" href="#a"><h3>PLAN A · Castillo + Nakanoshima + Tenmangu</h3><div class="route">Hommachi → Castillo → Nakanoshima → Kitahama → Tenmangu → Tenjinbashisuji → Hommachi</div><p><Prio t="must" texto="⭐" /> Castillo + paseo por Nakanoshima. <Prio t="maybe" texto="🟡" /> Umeda Sky si hay ganas.</p></a>
      <a class="choice" href="#b"><h3>PLAN B · Shitennoji + Shinsekai + teamLab</h3><div class="route">Hommachi → Shitennoji → Tennoji → Shinsekai → Nagai → Hommachi</div><p><Prio t="must" texto="⭐" /> Shitennoji + Shinsekai. <Prio t="maybe" texto="🟡" /> teamLab si hay entrada y energía.</p></a>
      <a class="choice" href="#c"><h3>PLAN C · Minami completo</h3><div class="route">Hommachi → Namba Yasaka → Kuromon → Den-Den → Dotonbori → Shinsaibashi → Hommachi</div><p><Prio t="must" texto="⭐" /> Dotonbori + paseo por Minami. <Prio t="maybe" texto="🟡" /> Kuromon / Den-Den según ganas.</p></a>
      <a class="choice" href="#d"><h3>PLAN D · Nara</h3><div class="route">Hommachi → Osaka-Namba A01 → Kintetsu-Nara A28 → Nara Park → Todaiji → Kasuga → Hommachi</div><p><Prio t="must" texto="⭐" /> Nara Park + Todaiji. <Prio t="maybe" texto="🟡" /> Kasuga si seguimos con energía.</p></a>
    </div>
    <Aviso tipo="azul" titulo="Regla"><p>Podemos hacer A el 22, C el 23 y D el 24, o cualquier otra combinación. Ninguna excursión queda “reservada” a una fecha salvo que una entrada lo exija.</p></Aviso>
  </Seccion>

  <Seccion id="a" fondo="alt">
    <DiaHead fecha="PLAN A · CASTILLO + NAKANOSHIMA + TENMANGU + TENJINBASHISUJI" titulo="<strong>Historia → río → Osaka tradicional</strong>" zona="Plan independiente" />
    <p class="lead">El recorrido más progresivo de los cuatro. Primero el Castillo y después hacia el centro caminando. El núcleo del día es <strong>Castillo → Nakanoshima → Yodoyabashi/Kitahama → Osaka Tenmangu → Tenjinbashisuji</strong>. Umeda solo entra si todavía hay ganas.</p>
    <TarjetaEstacion kicker="Ida · primer tramo" titulo={`Hommachi ${C(16)} → Tanimachi 4-chome ${C(18)}`} texto="Aquí sí usamos metro: nos deja exactamente donde empieza el recorrido del Castillo.">
      <MiniMapa
        titulo={`${lin('chuo')} ${dir('Nagata / Gakken-Nara-Tomigaoka')}`}
        paradas={[
          { nombre: 'Hommachi', est: ['chuo', 16], tipo: 'hotel', sig: { modo: 'linea', l: 'chuo' } },
          { nombre: 'Sakaisuji-Hommachi', est: ['chuo', 17], sig: { modo: 'linea', l: 'chuo' } },
          { nombre: 'Tanimachi 4-chome', sub: 'Exit 9', est: ['chuo', 18], tipo: 'destacado', sig: { modo: 'andar', label: '🚶 10 min' } },
          { nombre: 'Castillo', sub: 'Osaka Castle Park', tipo: 'destacado' },
        ]}
      />
      <Pasos items={[
        { t: `En Hommachi buscamos ${C(16)} · Chuo Line (verde).`, d: 'No buscamos Midosuji. El objetivo de este plan es la <strong>Chuo Line</strong>.' },
        { t: 'Dirección Nagata / Gakken-Nara-Tomigaoka.', d: `Subimos y contamos <strong>2 paradas</strong>: ${C(17)} Sakaisuji-Hommachi → ${C(18, 'Tanimachi 4-chome')}.` },
        { t: `Bajamos en ${C(18)} y buscamos Exit 9.`, d: 'Es la salida de referencia para Osaka Castle Park y el Museum of History.' },
      ]} />
    </TarjetaEstacion>
    <Timeline>
      <TL hora="09:00" titulo="Osaka Castle" prio="must">Entramos al parque y seguimos las señales de <strong>Castle Tower</strong>. No intentamos recorrer todo el recinto: la prioridad es disfrutar del castillo y del parque sin convertir la mañana en una carrera.</TL>
      <TL hora="11:30–12:15" titulo="Osaka Museum of History" prio="maybe" prioTexto="🟡">Junto a la zona del Castillo. Si apetece seguir con historia, entramos; si no, lo saltamos: <strong>no es necesario para que el Plan A funcione</strong>.</TL>
      <TL hora="12:15–13:30" titulo="Hacia Nakanoshima" tipo="andar" etiqueta="A pie">Desde la zona del Castillo seguimos <strong>andando</strong> hacia Nakanoshima. Es el tramo de paseo del día; no vamos saltando de estación en estación. Si las piernas pesan, aquí recortamos con taxi a Nakanoshima/Yodoyabashi.</TL>
      <TL hora="13:30–15:00" titulo="Nakanoshima Park → Central Public Hall → Yodoyabashi" tipo="andar" prio="must" prioTexto="⭐">Parque junto al río y el <strong>Osaka City Central Public Hall</strong>, edificio histórico de ladrillo rojo, a unos 5 min de Yodoyabashi. No hace falta entrar: el exterior ya es la visita.</TL>
      <TL hora="15:00–16:00" titulo="Kitahama" tipo="andar">Edificios históricos, río y zona financiera. Buen momento para parar a tomar algo.</TL>
      <TL hora="16:00–17:30" titulo="Osaka Tenmangu + Tenjinbashisuji" tipo="andar" prio="must" prioTexto="⭐">Un mismo bloque: el santuario y, al salir, la gran galería comercial. <strong>No intentamos recorrer sus 2,6 km</strong>: caminamos el tramo que apetezca y damos la vuelta.</TL>
      <TL hora="17:30–19:00" titulo="Umeda / Umeda Sky Building" prio="maybe" prioTexto="🟡">Solo si queda energía. Si estamos cansados, <strong>es lo primero que eliminamos</strong>.</TL>
    </Timeline>
    <MapaAndando
      titulo="El paseo del Plan A"
      sub="Una vez dejamos el Castillo avanzamos hacia el oeste y el norte, sin volver al metro."
      ciudad="Osaka"
      distancia="≈ 5–6 km en todo el día"
      tiempo="repartidos entre visitas"
      puntos={[
        { n: 'Tanimachi 4 · Exit 9', lat: 34.6826, lon: 135.5170, t: 'estacion', q: 'Tanimachi 4-chome Station Exit 9' },
        { n: 'Osaka Castle', lat: 34.6873, lon: 135.5262, q: 'Osaka Castle Main Tower' },
        { n: 'Museum of History', lat: 34.6826, lon: 135.5205, q: 'Osaka Museum of History' },
        { n: 'Nakanoshima Park', lat: 34.6936, lon: 135.5088, q: 'Nakanoshima Park Rose Garden' },
        { n: 'Central Public Hall', lat: 34.6922, lon: 135.5045, q: 'Osaka City Central Public Hall' },
        { n: 'Kitahama', lat: 34.6905, lon: 135.5067, q: 'Kitahama Station, Osaka' },
